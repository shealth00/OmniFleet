[Unit]
Description=OmniFleet Backend API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=izzy
Group=izzy
WorkingDirectory=/home/izzy/OmniFleet-Backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/home/izzy/OmniFleet-Backend/.env

[Install]
WantedBy=multi-user.target
