# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: API endpoint for the OmniFleet backend.
# Defaults to http://localhost:3000 if not set.
# For production, set to your deployed backend URL.
VITE_API_URL="http://localhost:3000"

# Google EMM Integration Configuration
# Required for Google Enterprise Mobility Management integration.
# Obtain these credentials from Google Cloud Console:
# https://console.cloud.google.com

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for Google EMM.
# Create this in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret for Google EMM.
# Keep this secret and never commit it to version control.
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# GOOGLE_PROJECT_ID: Google Cloud Project ID for EMM integration.
# This is the project ID where you enabled Android Management API.
GOOGLE_PROJECT_ID="YOUR_GOOGLE_PROJECT_ID"

# GOOGLE_REDIRECT_URI: OAuth 2.0 Redirect URI.
# This must match the redirect URI configured in Google Cloud Console.
# For development: http://localhost:3000/api/emm/oauth/callback
# For production: https://your-app-domain.com/api/emm/oauth/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/emm/oauth/callback"
